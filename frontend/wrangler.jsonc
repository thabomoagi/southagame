{
  "name": "southagame-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "vars": {
    "PUBLIC_API_BASE_URL": "https://southagame.onrender.com/api/v1"
  }
}